.tarot-main
  .tarot-main__hero
    .tarot-main__badge {{ t('main.badge') }}
    h1.tarot-main__title SEASON
    h2.tarot-main__subtitle TAROT
    .tarot-main__card-wrap
      img.tarot-main__card-img(src="/assets/images/CardB.png", alt="타로 카드")
    p.tarot-main__desc {{ t('main.desc1') }}
    p.tarot-main__desc2 {{ t('main.desc2') }}

  .tarot-main__action
    button.tarot-main__btn(type="button", [routerLink]="'/AItarot/user'")
      span {{ t('main.cta') }}
      svg(xmlns="http://www.w3.org/2000/svg", width="20", height="20", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
        line(x1="5", y1="12", x2="19", y2="12")
        polyline(points="12 5 19 12 12 19")

  .tarot-main__menu
    .tarot-main__menu-item([routerLink]="'/tarot/user'")
      .tarot-main__menu-icon 🔮
      .tarot-main__menu-text
        .tarot-main__menu-title {{ t('main.menu.daily.title') }}
        .tarot-main__menu-desc {{ t('main.menu.daily.desc') }}
      .tarot-main__menu-arrow
        svg(xmlns="http://www.w3.org/2000/svg", width="16", height="16", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
          polyline(points="9 18 15 12 9 6")

    .tarot-main__menu-item([routerLink]="'/tarotT/user'")
      .tarot-main__menu-icon ✨
      .tarot-main__menu-text
        .tarot-main__menu-title {{ t('main.menu.today.title') }}
        .tarot-main__menu-desc {{ t('main.menu.today.desc') }}
      .tarot-main__menu-arrow
        svg(xmlns="http://www.w3.org/2000/svg", width="16", height="16", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
          polyline(points="9 18 15 12 9 6")

    .tarot-main__menu-item([routerLink]="'/tarotP/user'")
      .tarot-main__menu-icon 🃏
      .tarot-main__menu-text
        .tarot-main__menu-title {{ t('main.menu.season.title') }}
        .tarot-main__menu-desc {{ t('main.menu.season.desc') }}
      .tarot-main__menu-arrow
        svg(xmlns="http://www.w3.org/2000/svg", width="16", height="16", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
          polyline(points="9 18 15 12 9 6")

    .tarot-main__menu-item([routerLink]="'/tarotw/user'")
      .tarot-main__menu-icon 🌸
      .tarot-main__menu-text
        .tarot-main__menu-title {{ t('main.menu.yearly.title') }}
        .tarot-main__menu-desc {{ t('main.menu.yearly.desc', null, { year: currentYear }) }}
      .tarot-main__menu-arrow
        svg(xmlns="http://www.w3.org/2000/svg", width="16", height="16", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
          polyline(points="9 18 15 12 9 6")

    .tarot-main__menu-item([routerLink]="'/tarotM/user'")
      .tarot-main__menu-icon 📅
      .tarot-main__menu-text
        .tarot-main__menu-title {{ t('main.menu.monthly.title') }}
        .tarot-main__menu-desc {{ t('main.menu.monthly.desc') }}
      .tarot-main__menu-arrow
        svg(xmlns="http://www.w3.org/2000/svg", width="16", height="16", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
          polyline(points="9 18 15 12 9 6")
